{
  "name": "clone-trello",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "typecheck": "nuxt typecheck",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "npm run test:unit && npm run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "test:server": "tsx --env-file=.env scripts/test-server.ts",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "services:up": "docker compose up -d",
    "services:stop": "docker compose stop",
    "setup": "node scripts/setup-env.mjs"
  },
  "dependencies": {
    "@nuxtjs/i18n": "^10.4.0",
    "@pinia/nuxt": "^0.11.3",
    "@vueuse/core": "^14.3.0",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^1.0.0",
    "nanoid": "^5.1.16",
    "nodemailer": "^10.0.10",
    "nuxt": "^3.21.8",
    "ofetch": "^1.5.1",
    "pg": "^8.23.0",
    "pinia": "^3.0.4",
    "radix-vue": "^1.9.17",
    "shadcn-nuxt": "^2.7.4",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.39",
    "vue-router": "^4.6.4",
    "vuedraggable": "^4.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@nuxtjs/color-mode": "^3.5.2",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.6"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
